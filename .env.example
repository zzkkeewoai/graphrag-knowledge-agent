# GraphRAG 环境变量模板
# 用法：cp .env.example .env 然后按实际情况填写
# 注意：.env 已被 .gitignore 忽略，绝不要把真实密钥提交到仓库

# ============ LLM（抽取/生成需要；纯模板模式可不填）============
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 模板模式（false）不调 LLM，便于离线跑测试与评测
USE_LLM_ANSWER=false
USE_LLM_ROUTER=false

# 多 Provider 热备：按顺序尝试，主供应商故障自动切备用
# 每家的 key 用 <NAME>_API_KEY；可选 <NAME>_BASE_URL / <NAME>_MODEL 覆盖默认值
# 支持 deepseek / qwen / zhipu / openai（未配置 key 的会被自动跳过）
LLM_PROVIDERS=deepseek,qwen
LLM_TIMEOUT_SECONDS=30

# ============ Neo4j（必须与 docker-compose.yml 的 NEO4J_AUTH 一致）============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ============ Milvus ============
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============ 编排与缓存 ============
MAX_RETRIES=3
MAX_STEPS=15
USE_SEMANTIC_CACHE=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
# 知识库更新后 bump 此版本号，旧缓存自动失效
KNOWLEDGE_VERSION=1

# ============ 分布式语义缓存（可选；需先启动：docker compose up -d redis）============
# true → 用 Redis（多实例共享、重启不丢）；Redis 不可用会自动回退进程内缓存
# 单机/开发环境保持 false 即可（零依赖）
USE_REDIS_CACHE=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============ 检索参数 ============
CONFIDENCE_THRESHOLD=0.7
VECTOR_TOP_K=10
GRAPH_TOP_K=10
FUSION_TOP_K=5
RERANK_TOP_K=3
